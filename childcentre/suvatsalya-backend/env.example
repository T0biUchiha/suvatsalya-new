# Copy to .env and fill in values from the project owner / Render dashboard
# cp env.example .env

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=<min-32-char-random-string>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
# Use 5002 if 5001 is taken (e.g. Docker)
PORT=5002
CORS_ORIGIN=http://localhost:5173

# Emergency admin password reset (POST /api/auth/reset-password) — keep private
# See ../README.md § "Admin password" for curl examples. Password is NOT stored in plain text;
# the API returns newPassword once in the JSON response when you reset.
ADMIN_RESET_SECRET=<long-random-secret-min-32-chars>

# Optional: store last reset password locally (never commit real values)
# ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=<from-reset-password-api-response>
